[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform vec2 Speed;
uniform sampler2D tex_frg_6;
uniform sampler2D tex_frg_16;
uniform sampler2D tex_frg_2;



void vertex() {
	mat4 n_out2p0;
// GetBillboardMatrix:2
	{
		mat4 __mvm = VIEW_MATRIX * mat4(INV_VIEW_MATRIX[0], MODEL_MATRIX[1], vec4(normalize(cross(INV_VIEW_MATRIX[0].xyz, MODEL_MATRIX[1].xyz)), 0.0), MODEL_MATRIX[3]);
		__mvm = __mvm * mat4(vec4(length(MODEL_MATRIX[0].xyz), 0.0, 0.0, 0.0), vec4(0.0, 1.0, 0.0, 0.0), vec4(0.0, 0.0, length(MODEL_MATRIX[2].xyz), 0.0), vec4(0.0, 0.0, 0.0, 1.0));
		n_out2p0 = __mvm;
	}


// Output:0
	MODELVIEW_MATRIX = n_out2p0;


}

void fragment() {
// Input:7
	vec2 n_out7p0 = UV;


// Input:15
	float n_out15p0 = TIME;


// Vector2Parameter:20
	vec2 n_out20p0 = Speed;


// VectorOp:14
	vec2 n_out14p0 = vec2(n_out15p0) * n_out20p0;


// UVFunc:13
	vec2 n_in13p1 = vec2(1.00000, 1.00000);
	vec2 n_out13p0 = n_out14p0 * n_in13p1 + UV;


// Texture2D:6
	vec4 n_out6p0 = texture(tex_frg_6, n_out13p0);


// VectorDecompose:9
	float n_out9p0 = n_out6p0.x;
	float n_out9p1 = n_out6p0.y;
	float n_out9p2 = n_out6p0.z;
	float n_out9p3 = n_out6p0.w;


// FloatOp:12
	float n_in12p1 = 4.00000;
	float n_out12p0 = n_out9p0 / n_in12p1;


// Texture2D:16
	vec4 n_out16p0 = texture(tex_frg_16, UV);


// VectorDecompose:18
	float n_out18p0 = vec3(n_out16p0.xyz).x;
	float n_out18p1 = vec3(n_out16p0.xyz).y;
	float n_out18p2 = vec3(n_out16p0.xyz).z;


// FloatOp:17
	float n_out17p0 = n_out12p0 * n_out18p0;


// VectorOp:8
	vec2 n_out8p0 = n_out7p0 + vec2(n_out17p0);


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out8p0);


// Input:19
	vec4 n_out19p0 = COLOR;


// VectorOp:3
	vec4 n_out3p0 = n_out2p0 * n_out19p0;


// VectorDecompose:5
	float n_out5p0 = n_out2p0.x;
	float n_out5p1 = n_out2p0.y;
	float n_out5p2 = n_out2p0.z;
	float n_out5p3 = n_out2p0.w;


// Output:0
	ALBEDO = vec3(n_out3p0.xyz);
	ALPHA = n_out5p0;


}
"
