[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec2 Cloud_Speed;
uniform sampler2D tex_vtx_6 : source_color;
uniform float Cloud_Intensity;
uniform sampler2D tex_frg_2 : source_color;
uniform sampler2D tex_frg_3;
uniform sampler2D tex_frg_14 : source_color;
uniform sampler2D depth_tex_frg_20 : hint_depth_texture;
uniform vec4 Explosion_Color : source_color = vec4(1.000000, 0.300000, 0.100000, 1.000000);
uniform sampler2D tex_frg_11;



void vertex() {
// Input:2
	vec3 n_out2p0 = VERTEX;


// Input:3
	vec3 n_out3p0 = NORMAL;


// Input:10
	float n_out10p0 = TIME;


// Vector2Parameter:12
	vec2 n_out12p0 = Cloud_Speed;


// VectorOp:11
	vec2 n_out11p0 = vec2(n_out10p0) * n_out12p0;


// UVFunc:9
	vec2 n_in9p1 = vec2(1.00000, 1.00000);
	vec2 n_out9p0 = n_out11p0 * n_in9p1 + UV;


// Texture2D:6
	vec4 n_out6p0 = texture(tex_vtx_6, n_out9p0);
	float n_out6p1 = n_out6p0.r;


// FloatParameter:14
	float n_out14p0 = Cloud_Intensity;


// FloatOp:8
	float n_out8p0 = n_out6p1 * n_out14p0;


// VectorOp:7
	vec3 n_out7p0 = n_out3p0 * vec3(n_out8p0);


// VectorOp:5
	vec3 n_out5p0 = n_out2p0 + n_out7p0;


// Output:0
	VERTEX = n_out5p0;


}

void fragment() {
// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, UV);
	float n_out2p1 = n_out2p0.r;


// Texture2D:3
	vec4 n_out3p0 = texture(tex_frg_3, vec2(n_out2p1));


// Input:18
	vec4 n_out18p0 = COLOR;
	float n_out18p4 = n_out18p0.a;


// Texture2D:14
	vec4 n_out14p0 = texture(tex_frg_14, UV);
	float n_out14p1 = n_out14p0.r;


// SmoothStep:15
	float n_in15p1 = 1.00000;
	float n_out15p0 = smoothstep(n_out18p4, n_in15p1, n_out14p1);


	float n_out20p0;
// ProximityFade:20
	float n_in20p0 = 1.00000;
	{
		float __depth_tex = texture(depth_tex_frg_20, SCREEN_UV).r;
		vec4 __depth_world_pos = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0 - 1.0, __depth_tex, 1.0);
		__depth_world_pos.xyz /= __depth_world_pos.w;
		n_out20p0 = clamp(1.0 - smoothstep(__depth_world_pos.z + n_in20p0, __depth_world_pos.z, VERTEX.z), 0.0, 1.0);
	}


// FloatOp:21
	float n_out21p0 = n_out15p0 * n_out20p0;


// ColorParameter:4
	vec4 n_out4p0 = Explosion_Color;


// FloatConstant:6
	float n_out6p0 = 10.000000;


// VectorOp:5
	vec3 n_out5p0 = vec3(n_out4p0.xyz) * vec3(n_out6p0);


// Input:19
	vec4 n_out19p0 = COLOR;
	float n_out19p1 = n_out19p0.r;


// Texture2D:11
	vec4 n_out11p0 = texture(tex_frg_11, UV);


// SmoothStep:9
	float n_in9p1 = 1.00000;
	float n_out9p0 = smoothstep(n_out19p1, n_in9p1, n_out11p0.x);


// VectorOp:8
	vec3 n_out8p0 = n_out5p0 * vec3(n_out9p0);


// Output:0
	ALBEDO = vec3(n_out3p0.xyz);
	ALPHA = n_out21p0;
	EMISSION = n_out8p0;


}
"
